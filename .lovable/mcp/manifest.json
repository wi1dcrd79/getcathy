{
  "version": 1,
  "sdk_version": "3.0.4",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://hvzkxlpbcsquiiourxyy.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "c-a-t-h-y",
      "version": "0.1.0",
      "title": "C.A.T.H.Y"
    },
    "tools": [
      {
        "name": "list_assets",
        "title": "List assets",
        "description": "List your company's tracked assets with site, zone, bin and status; optionally search by name, tag or serial/VIN.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "search": {
              "description": "Match name, asset tag or serial/VIN.",
              "type": "string",
              "maxLength": 80
            },
            "limit": {
              "default": 25,
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "list_inspections",
        "title": "List inspections",
        "description": "List recent inspections for your company with result and expiration date; optionally only failed ones.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "failed_only": {
              "default": false,
              "description": "Only return failed inspections.",
              "type": "boolean"
            },
            "limit": {
              "default": 25,
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "list_expiring_certs",
        "title": "List expiring certifications",
        "description": "List your company's personnel certifications that are lapsed or expire within the given number of days.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "within_days": {
              "default": 30,
              "description": "Look-ahead window in days.",
              "type": "integer",
              "minimum": 0,
              "maximum": 365
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
