# C.A.T.H.Y. Environment Variables
# Copy this file to .env and fill in the real values (NEVER commit .env)
# Public keys (safe to commit) vs. Secret keys (use environment variables only)

# ============================================================================
# SUPABASE (Backend & Auth)
# ============================================================================
# Public (OK to expose to browser)
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Server-side (KEEP SECRET - set in hosting platform only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================================
# PADDLE PAYMENTS (Billing & Subscriptions)
# ============================================================================
# This is a Paddle client token that switches between sandbox and live
# based on the prefix: test_* = sandbox, prod_* = live
# Public (OK to expose to browser)
VITE_PAYMENTS_CLIENT_TOKEN=test_1a2b3c4d5e6f7g8h9i0j

# Server-side (KEEP SECRET - set in hosting platform only)
# Sandbox (for testing)
PADDLE_SANDBOX_API_KEY=test_abc123def456ghi789jkl012
PAYMENTS_SANDBOX_WEBHOOK_SECRET=whsec_test_abc123def456ghi789jkl012

# Live (after Paddle verification; uncomment when ready)
# PADDLE_LIVE_API_KEY=live_abc123def456ghi789jkl012mnopqrstu
# PAYMENTS_LIVE_WEBHOOK_SECRET=whsec_live_abc123def456ghi789jkl012

# ============================================================================
# LOVABLE CLOUD (Connector Gateway for Paddle)
# ============================================================================
# Server-side (KEEP SECRET - set in hosting platform only)
LOVABLE_API_KEY=lca_abc123def456ghi789jkl012

# ============================================================================
# INNGEST (Durable Execution & Background Jobs)
# ============================================================================
# Server-side (KEEP SECRET - set in hosting platform only; not yet used)
# INNGEST_API_KEY=
# INNGEST_SIGNING_KEY=

# ============================================================================
# NOTES
# ============================================================================
# 1. For local development (.env file):
#    - Copy this file to .env
#    - Fill in VITE_* vars (public keys are OK)
#    - Fill in server vars from Supabase/Paddle dashboards
#    - DO NOT commit .env
#
# 2. For production (Lovable Cloud / Vercel / hosting):
#    - Set environment variables in your platform dashboard
#    - Never put secrets in code or committed files
#    - Use VITE_* prefix for client-side vars only
#
# 3. Paddle account setup:
#    - Go to https://paddle.com and create a Merchant account
#    - Complete business verification (2-5 days)
#    - Create Products: "Field Yard Pro" (field_yard_pro_monthly) and 
#      "Enterprise Contractor" (enterprise_contractor_monthly)
#    - Set webhook URL to: https://<your-domain>/api/public/payments/webhook?env=sandbox|live
#    - Copy API keys and webhook secrets here
#
# 4. Testing Paddle in sandbox:
#    - Use test card: 4111 1111 1111 1111
#    - Check webhook delivery in Paddle Dashboard
#    - Verify subscription synced to Supabase
